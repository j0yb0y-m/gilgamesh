# Gilgamesh environment — installed by install.sh as /etc/gilgamesh/gilgamesh.env
# (mode 0640, root:gilgamesh) and read by all three units. Every name is a Settings
# field with the GILGAMESH_ prefix; a process ignores the ones it does not use.
#
# Secrets never go here. The admin password hash, the Discord/Telegram/SMTP credentials
# and the TLS material are entered through the web UI and stored in the database (or
# generated into the state directory); this file only carries deployment facts.

# --- shared -----------------------------------------------------------------
# The SQLite database directory. install.sh creates it as 0770 gilgamesh:gilgamesh —
# that group membership is how the sensor process reaches the database.
GILGAMESH_DATA_DIR=/var/lib/gilgamesh

# --- web --------------------------------------------------------------------
# The UI binds every address. In the documented inline deployment the two bridge
# members hold no IP address of their own, so only the management address is reachable.
GILGAMESH_HOST=0.0.0.0
GILGAMESH_PORT=8080
# Set this to the management IP (comma-separated for several) once you know it: it
# blunts DNS-rebinding attacks. "*" answers to any Host header, which is what makes the
# first visit work before you know the address.
GILGAMESH_ALLOWED_HOSTS=*
# Interactive API documentation (/docs). Only for a deliberate demo.
GILGAMESH_ENABLE_API_DOCS=0

# --- sensor -----------------------------------------------------------------
# The interface to capture from — in the documented deployment, the bridge. The sensor
# refuses to start when this is empty (a sensor that silently detects nothing is worse
# than one that does not start). `ip -br link` lists the candidates.
GILGAMESH_INTERFACE=br0
# Optional: the gateway address used by the ARP gateway check. Leave commented out to
# read the default route (/proc/net/route) at start-up.
#GILGAMESH_GATEWAY_IP=192.168.1.1
# Optional: Suricata's EVE JSON log to tail. Commented out, the custom detectors are the
# only source; set it to get Suricata's signatures too. The sensor waits for the file to
# appear, so starting before Suricata is harmless.
GILGAMESH_SURICATA_EVE_PATH=/var/log/suricata/eve.json

# --- rules update -----------------------------------------------------------
# suricata-update fetches the ruleset; suricatasc asks a running Suricata to reload it.
GILGAMESH_SURICATA_UPDATE_COMMAND=suricata-update
GILGAMESH_SURICATA_SOCKET=/var/run/suricata/suricata-command.socket
