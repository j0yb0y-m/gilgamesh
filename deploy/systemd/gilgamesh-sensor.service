[Unit]
Description=Gilgamesh packet-capture sensor
Documentation=file:/opt/gilgamesh/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gilgamesh-sensor
Group=gilgamesh-sensor
# Group membership is how the sensor writes into the web user's state directory.
SupplementaryGroups=gilgamesh
WorkingDirectory=/opt/gilgamesh
EnvironmentFile=/etc/gilgamesh/gilgamesh.env
ExecStart=/opt/gilgamesh/.venv/bin/gilgamesh-sensor
Restart=on-failure
RestartSec=5s

# The sensor owns no directory of its own: it writes events and devices into the shared
# database at /var/lib/gilgamesh (created by install.sh, and by the web unit's
# StateDirectory=). ProtectSystem=strict makes everything else read-only, so this path
# must exist before the unit starts.
ReadWritePaths=/var/lib/gilgamesh
UMask=0007

# --- capture capabilities: raw sockets, no root ---
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes

# --- hardening (each directive verified in systemd.exec(5), systemd 257) ---
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# AF_PACKET is the capture socket itself.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_PACKET

[Install]
WantedBy=multi-user.target
