[Unit]
Description=Gilgamesh web UI and API
Documentation=file:/opt/gilgamesh/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gilgamesh
Group=gilgamesh
WorkingDirectory=/opt/gilgamesh
# Created by install.sh from deploy/gilgamesh.env.example. Missing = the unit refuses to
# start rather than silently running with the wrong data directory.
EnvironmentFile=/etc/gilgamesh/gilgamesh.env
# The venv entry point, not `uv run`: the service must not depend on a tool being on
# PATH, and starting must never attempt to resolve or download packages on a box with
# no internet.
ExecStart=/opt/gilgamesh/.venv/bin/gilgamesh-web
Restart=on-failure
RestartSec=5s

# /var/lib/gilgamesh holds the database: the admin password hash, the notifier secrets
# (webhook URLs, bot token, SMTP password) and every recorded event. 0770 plus this UMask
# keeps it out of the reach of every other account on the box — SQLite creates the -wal
# and -shm files alongside it with the same umask.
StateDirectory=gilgamesh
StateDirectoryMode=0770
UMask=0007

# --- hardening (each directive verified in systemd.exec(5), systemd 257) ---
# StateDirectory= is excluded from ProtectSystem=strict, so the database stays writable
# while the rest of the filesystem does not.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
